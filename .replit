run = "pip install -r requirements.txt && gunicorn app:app --workers 1 --bind 0.0.0.0:8080 --timeout 120"
entrypoint = "app.py"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && gunicorn app:app --workers 1 --bind 0.0.0.0:8080 --timeout 120"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
