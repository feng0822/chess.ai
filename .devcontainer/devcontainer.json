{
  "name": "Chess AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt && chmod +x Linux/pikafish-*",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "象棋网站",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
